<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.github.munki-api</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/Shared/munki-api/venv/bin/python</string>
        <string>/Users/Shared/munki-api/app.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/Shared/munki-api</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/var/log/munki-api.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/munki-api.error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
